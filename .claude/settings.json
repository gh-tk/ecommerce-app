{
  "permissions": {
    "allow": [
      "Bash(git status)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git branch:*)",
      "Bash(dotnet build:*)",
      "Bash(dotnet test:*)",
      "Bash(dotnet format:*)",
      "Bash(dotnet list package:*)",
      "Bash(dotnet user-secrets list:*)",
      "Bash(gitleaks:*)",
      "Bash(trivy:*)",
      "Bash(docker ps:*)",
      "Bash(docker images:*)"
    ],
    "ask": [
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(gh pr create:*)",
      "Bash(dotnet add:*)",
      "Bash(dotnet user-secrets set:*)",
      "Bash(docker build:*)"
    ],
    "deny": [
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(gh pr merge:*)",
      "Bash(dotnet ef database drop:*)",
      "Read(./.env)",
      "Read(./**/.env)",
      "Read(./**/*.pem)",
      "Read(./**/*.key)",
      "Read(./**/appsettings.*.local.json)"
    ]
  },
  "extraKnownMarketplaces": {
    "oddo-dev-marketplace": {
      "source": {
        "source": "github",
        "repo": "ODDO-BHF/claude-dev-toolkit"
      }
    }
  },
  "enabledPlugins": {
    "oddo-dev-standard@oddo-dev-marketplace": true
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/tests-must-pass.sh",
            "timeout": 300
          }
        ]
      }
    ]
  }
}
